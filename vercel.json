{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/pdf",
      "destination": "/VERCEL_SECURITY_BREACH_CASE_STUDY.pdf"
    },
    {
      "source": "/case-study",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*).pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    }
  ]
}
